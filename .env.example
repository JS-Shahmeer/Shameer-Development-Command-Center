# Copy to .env and fill in. Never commit .env.

# Postgres. Locally, `docker compose up -d` starts one matching these values.
# On Vercel with Neon: DATABASE_URL is the pooled URL, DIRECT_URL the direct (unpooled) one.
DATABASE_URL="postgresql://dcc:dcc@localhost:5432/dcc"
DIRECT_URL="postgresql://dcc:dcc@localhost:5432/dcc"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github (and your Vercel domain).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The first person to sign in with this email becomes an admin. Everyone else needs an invite.
ADMIN_EMAIL=""

# Local only: adds a "sign in as a seeded user" form. Ignored outside `next dev`.
AUTH_DEV_LOGIN="true"

# Claude API, used only for AI task breakdown, only on the server. Leave empty to turn the feature off.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=""
